# Valores de PRUEBA para levantar SIGMA en Docker.
#
# EXPLICACIÓN PARA PRINCIPIANTES:
# Copia este archivo a docker/.env y, si quieres, cambia la clave.
# docker/.env NO se sube a git (está en .gitignore).
# En el servidor sic-sigma reemplaza SECRET_KEY, DB_PASSWORD y DEBUG.
# No pegues aquí contraseñas reales de producción.

# --- Django (obligatorias: sin ellas SIGMA no arranca) ---
SECRET_KEY=docker-local-solo-pruebas-cambia-esta-clave-9f3c7a1e5b
DEBUG=True

# --- PostgreSQL (el servicio se llama "postgres" dentro de Docker) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=inventario_mexico
DB_NAME_AR=inventario_argentina
DB_NAME_CL=inventario_chile
DB_NAME_CO=inventario_colombia
DB_USER=sigma
DB_PASSWORD=sigma_local_solo_pruebas
DB_HOST=postgres
DB_PORT=5432

# --- Redis: cola /0, resultados /1, caché /2 (igual que hoy) ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_CACHE_URL=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=False

# --- Quién puede abrir la página en la laptop ---
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SITE_URL=http://localhost:8080

# Dentro del contenedor /tmp alcanza. En el servidor viejo se usaba
# /var/www/django_temp por un problema de systemd que aquí no existe.
USE_CUSTOM_TEMP_DIR=False

# Puerto publicado en la laptop (Nginx). PostgreSQL y Redis no se publican.
SIGMA_HTTP_PORT=8080

# Token del túnel NUEVO de Cloudflare (Zero Trust → Tunnels).
# Vacío en git. Solo se llena en el servidor, en docker/.env.
# No reutilices el túnel del servidor viejo: ese sigue con México.
CLOUDFLARE_TUNNEL_TOKEN=

# Carpeta de datos en la laptop. En sic-sigma cambiar a /srv/sic/data/sigma
SIGMA_DATA_ROOT=./docker-data
